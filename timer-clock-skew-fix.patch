 src/firebase/clock.ts   | 25 +++++++++++++++++++++++++
 src/pages/Dashboard.tsx | 11 ++++++-----
 src/pages/Scanner.tsx   |  7 ++++---
 src/utils/schedule.ts   |  2 +-
 4 files changed, 36 insertions(+), 9 deletions(-)
 create mode 100644 src/firebase/clock.ts

diff --git a/src/firebase/clock.ts b/src/firebase/clock.ts
new file mode 100644
index 0000000..e14e905
--- /dev/null
+++ b/src/firebase/clock.ts
@@ -0,0 +1,25 @@
+/**
+ * Server-synced clock.
+ *
+ * outTimestamp / timestamp are written with serverTimestamp() (Firebase's
+ * clock), but elapsed-time math used to subtract them from Date.now() (the
+ * device's clock). On any iPad/Chromebook whose clock drifts, timers started
+ * at a non-zero value (or negative), and logged durations were skewed.
+ *
+ * Firebase publishes this device's offset from server time at
+ * .info/serverTimeOffset — use serverNow() anywhere a "now" is compared
+ * against a stored timestamp.
+ */
+import { ref, onValue } from 'firebase/database'
+import { db } from './config'
+
+let offsetMs = 0
+
+onValue(ref(db, '.info/serverTimeOffset'), snap => {
+  const v = snap.val()
+  offsetMs = typeof v === 'number' ? v : 0
+})
+
+export function serverNow(): number {
+  return Date.now() + offsetMs
+}
